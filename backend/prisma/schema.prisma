generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  FACULTY
  DEPARTMENT_ADMIN
  SYSTEM_ADMIN
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum CourseType {
  THEORY
  LAB
  SESSIONAL
}

enum MaterialCategory {
  LECTURE
  SLIDE
  BOOK
  REFERENCE
  LAB_MANUAL
}

enum SubmissionStatus {
  PENDING
  EVALUATED
  LATE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum AssessmentType {
  CT
  QUIZ
  LAB
  MIDTERM
  FINAL
}

enum PriorityLevel {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AudienceScope {
  ALL
  STUDENTS
  FACULTY
  BATCH
  COURSE
}

enum NotificationKind {
  ASSIGNMENT
  RESULT
  NOTICE
  SYSTEM
}

enum BatchStatus {
  ACTIVE
  GRADUATED
  ARCHIVED
}

enum EventType {
  EXAM
  CLASS
  HOLIDAY
  DEADLINE
  EVENT
}

enum LogSeverity {
  INFO
  WARN
  CRITICAL
}

model User {
  id             String     @id @default(uuid())
  email          String     @unique
  passwordHash   String
  name           String
  role           Role       @default(STUDENT)
  avatarInitials String
  emailVerified  Boolean    @default(true)
  identifier     String     @unique
  batch          String?
  designation    String?
  status         UserStatus @default(ACTIVE)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  studentProfile         Student?
  facultyProfile         Faculty?
  departmentAdminProfile DepartmentAdmin?

  noticesCreated Notice[]
  notifications  Notification[]
  forumPosts     ForumPost[]
  forumReplies   ForumReply[]
  activityLogs   ActivityLog[]

  @@map("users")
}

model Student {
  id             String   @id @default(uuid())
  userId         String   @unique
  rollNumber     String   @unique
  series         String
  batchId        String?
  registrationNo String?
  session        String?
  currentSemester Int     @default(6)
  cgpa           Float?   @default(3.58)

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  batchRef       Batch?   @relation(fields: [batchId], references: [id])

  enrollments    Enrollment[]
  submissions    Submission[]
  labSubmissions LabSubmission[]
  attendanceRecs AttendanceRecord[]
  results        Result[]
  alumniProfile  Alumni?

  @@map("students")
}

model Faculty {
  id                String   @id @default(uuid())
  userId            String   @unique
  staffId           String   @unique
  designation       String
  officeHours       String?
  bio               String?
  publicationsCount Int      @default(0)

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  courses           Course[]
  materialsUploaded Material[]
  assignmentsCreated Assignment[]
  attendanceSessions AttendanceSession[]
  allocations       CourseAssignment[]
  teacherReviews    TeacherReview[]

  @@map("faculty")
}

model DepartmentAdmin {
  id       String @id @default(uuid())
  userId   String @unique
  staffId  String @unique
  position String @default("Head of Department")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("department_admins")
}

model Batch {
  id              String      @id @default(uuid())
  name            String      @unique
  series          String      @unique
  admissionYear   Int
  studentCount    Int         @default(0)
  currentSemester Int         @default(1)
  status          BatchStatus @default(ACTIVE)

  students Student[]

  @@map("batches")
}

model Alumni {
  id             String  @id @default(uuid())
  studentId      String? @unique
  name           String
  series         String
  graduationYear Int
  currentRole    String
  organisation   String
  location       String

  student Student? @relation(fields: [studentId], references: [id])

  @@map("alumni")
}

model Course {
  id          String     @id @default(uuid())
  code        String     @unique
  title       String
  credits     Float
  semester    Int
  batchSeries String
  type        CourseType @default(THEORY)
  description String
  facultyId   String?

  faculty Faculty? @relation(fields: [facultyId], references: [id])

  enrollments         Enrollment[]
  materials           Material[]
  assignments         Assignment[]
  labExperiments      LabExperiment[]
  attendanceSessions  AttendanceSession[]
  results             Result[]
  allocations         CourseAssignment[]
  courseOutcomes      CO[]
  assessments         Assessment[]
  teacherReviews      TeacherReview[]

  @@map("courses")
}

model Enrollment {
  id           String   @id @default(uuid())
  studentId    String
  courseId     String
  semester     Int
  academicYear String
  status       String   @default("ENROLLED")
  createdAt    DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@map("enrollments")
}

model CourseAssignment {
  id          String   @id @default(uuid())
  courseId    String
  facultyId   String
  semester    Int
  batchSeries String
  createdAt   DateTime @default(now())

  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  faculty Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@map("course_assignments")
}

model Material {
  id          String           @id @default(uuid())
  courseId    String
  facultyId   String
  title       String
  description String
  fileName    String
  fileUrl     String?
  fileSizeKb  Int
  category    MaterialCategory @default(LECTURE)
  uploadedAt  DateTime         @default(now())

  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  faculty Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@map("materials")
}

model Assignment {
  id            String   @id @default(uuid())
  courseId      String
  facultyId     String
  title         String
  description   String
  deadline      DateTime
  totalMarks    Float    @default(20)
  attachmentUrl String?
  createdAt     DateTime @default(now())

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  faculty     Faculty      @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@map("assignments")
}

model Submission {
  id           String           @id @default(uuid())
  assignmentId String
  studentId    String
  submittedAt  DateTime         @default(now())
  fileName     String
  fileUrl      String?
  status       SubmissionStatus @default(PENDING)
  marks        Float?
  feedback     String?

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@map("submissions")
}

model Lab {
  id           String   @id @default(uuid())
  name         String
  inchargeName String
  capacity     Int
  equipment    String[]
  coursesList  String[]

  @@map("labs")
}

model LabExperiment {
  id        String @id @default(uuid())
  courseId  String
  number    Int
  title     String
  manualUrl String?

  course         Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  labSubmissions LabSubmission[]

  @@map("lab_experiments")
}

model LabSubmission {
  id           String           @id @default(uuid())
  experimentId String
  studentId    String
  submittedAt  DateTime         @default(now())
  reportUrl    String?
  status       SubmissionStatus @default(PENDING)
  marks        Float?
  feedback     String?

  experiment LabExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  student    Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("lab_submissions")
}

model AttendanceSession {
  id        String   @id @default(uuid())
  courseId  String
  facultyId String
  date      DateTime @default(now())
  topic     String?

  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  faculty Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  records AttendanceRecord[]

  @@map("attendance_sessions")
}

model AttendanceRecord {
  id        String           @id @default(uuid())
  sessionId String
  studentId String
  status    AttendanceStatus @default(PRESENT)

  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@map("attendance_records")
}

model Result {
  id            String         @id @default(uuid())
  studentId     String
  courseId      String
  type          AssessmentType
  date          DateTime       @default(now())
  obtainedMarks Float
  totalMarks    Float
  status        String         @default("PASSED")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("results")
}

model Notice {
  id          String        @id @default(uuid())
  authorId    String
  title       String
  description String
  audience    AudienceScope @default(ALL)
  priority    PriorityLevel @default(NORMAL)
  date        DateTime      @default(now())

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("notices")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  detail    String
  kind      NotificationKind @default(SYSTEM)
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model ForumCategory {
  id          String      @id @default(uuid())
  name        String
  description String
  posts       ForumPost[]

  @@map("forum_categories")
}

model ForumPost {
  id         String   @id @default(uuid())
  categoryId String?
  authorId   String
  courseCode String
  title      String
  content    String
  tags       String[]
  createdAt  DateTime @default(now())

  category ForumCategory? @relation(fields: [categoryId], references: [id])
  author   User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replies  ForumReply[]

  @@map("forum_posts")
}

model ForumReply {
  id        String   @id @default(uuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  post   ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("forum_replies")
}

model TeacherReview {
  id          String   @id @default(uuid())
  facultyId   String
  courseId    String
  studentId   String
  rating      Int
  comment     String
  isAnonymous Boolean  @default(true)
  createdAt   DateTime @default(now())

  faculty Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("teacher_reviews")
}

model AcademicEvent {
  id        String    @id @default(uuid())
  title     String
  date      DateTime
  type      EventType @default(EVENT)
  detail    String

  @@map("academic_events")
}

model PEO {
  id        String @id @default(uuid())
  code      String @unique
  statement String

  @@map("peos")
}

model PO {
  id          String         @id @default(uuid())
  code        String         @unique
  statement   String
  coMappings COPOMapping[]

  @@map("pos")
}

model PSO {
  id        String @id @default(uuid())
  code      String @unique
  statement String

  @@map("psos")
}

model CO {
  id         String @id @default(uuid())
  courseId   String
  code       String
  statement  String
  bloomLevel String

  course             Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  poMappings         COPOMapping[]
  assessmentMappings AssessmentCOMapping[]

  @@map("cos")
}

model COPOMapping {
  id               String @id @default(uuid())
  coId             String
  poId             String
  correlationLevel Int    @default(0)

  co CO @relation(fields: [coId], references: [id], onDelete: Cascade)
  po PO @relation(fields: [poId], references: [id], onDelete: Cascade)

  @@unique([coId, poId])
  @@map("co_po_mappings")
}

model Assessment {
  id       String         @id @default(uuid())
  courseId String
  name     String
  type     AssessmentType
  weight   Float

  course     Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  coMappings AssessmentCOMapping[]

  @@map("assessments")
}

model AssessmentCOMapping {
  id           String @id @default(uuid())
  assessmentId String
  coId         String
  weight       Float

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  co         CO         @relation(fields: [coId], references: [id], onDelete: Cascade)

  @@map("assessment_co_mappings")
}

model ActivityLog {
  id        String      @id @default(uuid())
  actorId   String?
  actorEmail String
  action    String
  entity    String
  severity  LogSeverity @default(INFO)
  ipAddress String
  createdAt DateTime    @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@map("activity_logs")
}
